#!/usr/bin/env bash

set -u

PACKAGES=(
  "com.miui.msa.global"
  "com.miui.analytics"
  "com.xiaomi.adservice"
  "com.facebook.appmanager"
  "com.facebook.services"
  "com.miui.mipicks"
  "com.mi.globalbrowser"
  "com.miui.videoplayer"
)

if ! command -v adb >/dev/null 2>&1; then
  echo "ADB wurde nicht gefunden. Bitte installiere Android Platform Tools." >&2
  exit 1
fi

if ! device_output=$(adb devices 2>&1); then
  printf 'ADB konnte die Geräteliste nicht lesen:\n%s\n' "$device_output" >&2
  exit 1
fi

mapfile -t device_rows < <(
  printf '%s\n' "$device_output" |
    awk '$0 == "List of devices attached" { in_devices = 1; next }
      in_devices && NF >= 2 {
      print $1 "\t" $2
    }'
)

if (( ${#device_rows[@]} != 1 )); then
  echo "Es muss genau ein ADB-Gerät verbunden sein. Erkannte Geräte:" >&2
  if (( ${#device_rows[@]} == 0 )); then
    echo "  keine" >&2
  else
    printf '  %s\n' "${device_rows[@]}" >&2
  fi
  echo "Bitte trenne weitere Geräte und autorisiere USB-Debugging." >&2
  exit 1
fi

IFS=$'\t' read -r device_serial device_state <<< "${device_rows[0]}"
if [[ "$device_state" != "device" ]]; then
  printf 'ADB-Gerät %s ist nicht autorisiert oder offline (%s).\n' \
    "$device_serial" "$device_state" >&2
  exit 1
fi

if ! adb -s "$device_serial" get-state >/dev/null 2>&1; then
  printf 'ADB-Gerät %s ist nicht erreichbar.\n' "$device_serial" >&2
  exit 1
fi

if ! android_uid=$(adb -s "$device_serial" shell id -u 2>&1); then
  printf 'Benutzer-ID des Geräts konnte nicht geprüft werden:\n%s\n' \
    "$android_uid" >&2
  exit 1
fi
android_uid=${android_uid//$'\r'/}
if [[ "$android_uid" == "0" ]]; then
  echo "Abbruch: Das ADB-Shell-Konto läuft als root. Root ist nicht erforderlich." >&2
  exit 1
fi

if ! user_id=$(adb -s "$device_serial" shell am get-current-user 2>&1); then
  printf 'Aktueller Android-Benutzer konnte nicht ermittelt werden:\n%s\n' \
    "$user_id" >&2
  exit 1
fi
user_id=${user_id//$'\r'/}
if [[ ! "$user_id" =~ ^[0-9]+$ ]]; then
  printf 'Ungültige Android-Benutzer-ID: %s\n' "$user_id" >&2
  exit 1
fi

echo "Zielgerät: $device_serial"
echo "Android-Benutzer: $user_id"
echo
echo "Das Skript versucht, diese Apps nur für diesen Benutzer zu deinstallieren:"
printf '  %s\n' "${PACKAGES[@]}"
echo
echo "Die Auswirkungen unterscheiden sich je nach MIUI/HyperOS-Version."
read -r -p "Zum Fortfahren exakt 'j' eingeben: " answer
if [[ "$answer" != "j" ]]; then
  echo "Abbruch."
  exit 0
fi

failures=0
for package in "${PACKAGES[@]}"; do
  printf '\nPrüfe %s ...\n' "$package"

  if ! installed_packages=$(
    adb -s "$device_serial" shell pm list packages "$package" 2>&1
  ); then
    printf 'Fehler beim Prüfen von %s:\n%s\n' "$package" "$installed_packages" >&2
    ((failures += 1))
    continue
  fi
  installed_packages=${installed_packages//$'\r'/}

  if ! grep -Fxq -- "package:$package" <<< "$installed_packages"; then
    echo "Nicht installiert; übersprungen."
    continue
  fi

  printf 'Deinstalliere %s für Benutzer %s ...\n' "$package" "$user_id"
  if result=$(
    adb -s "$device_serial" shell pm uninstall --user "$user_id" "$package" 2>&1
  ) && [[ "${result//$'\r'/}" == "Success" ]]; then
    echo "Erfolgreich deinstalliert."
  else
    printf 'Fehler beim Deinstallieren von %s:\n%s\n' \
      "$package" "${result//$'\r'/}" >&2
    ((failures += 1))
  fi
done

if (( failures > 0 )); then
  printf '\nFertig mit %d Fehler(n). Prüfe die obigen Meldungen.\n' "$failures" >&2
  exit 1
fi

echo
echo "Fertig."
